@startuml UsecasesKosmetichka
left to right direction

actor "Пользователь" as User
actor "Клиент" as Client
actor "Редактор" as Creator
actor "Администратор" as Admin
actor "Поставщик" as Supplier

usecase "Зарегистрироваться в системе" as 1
usecase "Войти в систему" as 2
usecase "Сбросить пароль" as 3
usecase "Найти товары" as 4

User --> 1
User --> 2
User --> 3
User --> 4

usecase "Посмотреть карточку товара" as A1
usecase "Прочитать новости" as A2
usecase "Прочитать акции" as A3
usecase "Задать вопрос" as A4
usecase "Управлять корзиной товаров" as A5

Client --|> User
Client --> A1
Client --> A2
Client --> A3
Client --> A4
Client --> A5

usecase "CRUD товары" as B1
usecase "CRUD новости" as B2
usecase "CRUD акции" as B3
usecase "CRUD категории" as B4
usecase "Редактировать информацию для карточки 'Поставщикам'" as B5

Creator --|> User
Creator --> B1
Creator --> B2
Creator --> B3
Creator --> B4
Creator --> B5

usecase "Изменить роль пользователя" as C1
usecase "Посмотреть статистику посещения сайта" as C2
usecase "Редактировать статус обращения" as C3
usecase "Редактировать контакты в обращении" as C4

Admin --|> Creator
Admin --> C1
Admin --> C2
Admin --> C3
Admin --> C4

usecase "Отправить заявку на сотрудничество" as D1

Supplier --|> User
Supplier --> D1
@enduml